# ==============================================================================
# NextPATH Environment Configuration File
# ==============================================================================
# Copy this file to '.env' and adjust the variables to match your deployment.
# Variables are ordered exactly as defined in docker-compose.yml.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Settings & Routing
# ------------------------------------------------------------------------------

# DNS Upstream Profile Selection.
# 1 = Cloudflare + Quad9 (1.1.1.1, 1.0.0.1, 9.9.9.10, 149.112.112.10)
# 2 = Google + Cloudflare (8.8.8.8, 8.8.4.4, 1.1.1.1)
# 3 = OpenDNS (208.67.222.222, 208.67.220.220)
# 4 = Quad9 No ECS (9.9.9.10, 149.112.112.10)
# 5 = ControlD + Quad9 (76.76.2.0, 9.9.9.10)
# 6 = AdGuard DNS Global (94.140.14.140, 94.140.14.141)
# 7 = CleanBrowsing Family (185.228.168.168, 185.228.169.168)
# Or set a custom comma-separated list (e.g., UPSTREAM_DNS="8.8.8.8, 1.1.1.1")
UPSTREAM_DNS=1

# Custom DNS routing rules.
# Format: zone1,zone2=dns1,dns2;zone3=dns3 (e.g. "org=8.8.8.8,8.8.4.4;co.uk=1.1.1.1")
CUSTOM_DNS_ROUTES="ru,xn--p1ai,su=195.208.4.1,195.208.5.1,62.76.76.62,62.76.62.76"

# Custom IP list for OpenNIC TLDs resolution.
OPENNIC_IPS="94.247.43.254,95.216.99.249,152.53.15.127,185.226.181.19"

# Enable IPv6 support. (y/n)
ENABLE_IPV6=y

# Restrict IPv6 resolution exclusively to proxied domains.
IPV6_PROXY_ONLY=y

# Bind DNS port 53 to public interfaces. (y/n)
PUBLIC_DNS=n

# External public IP of this server.
EXTERNAL_IP=

# ------------------------------------------------------------------------------
# DoH Endpoint
# ------------------------------------------------------------------------------

# Enable DoH endpoint. (y/n)
DOH_ENABLE=n

# DoH HTTPS listener port.
DOH_PORT=443

# --- DoH Certificate Mount Instructions ---
# For Docker Compose: Mount them as volumes (e.g., - ./certs:/app/nextpath/certs:ro)
# For Docker Swarm: They are natively injected via secrets into /run/secrets/cert.pem
# Note: If DOH_ENABLE is true but certificates are not found, the container will warn and disable DoH.

# DoH TLS Certificate absolute filepath (inside the container).
# Defaults to /app/nextpath/certs/cert.pem, or /run/secrets/cert.pem for Docker Swarm
DOH_CERT=

# DoH TLS Private Key absolute filepath (inside the container).
# Defaults to /app/nextpath/certs/key.pem, or /run/secrets/key.pem for Docker Swarm
DOH_KEY=

# ------------------------------------------------------------------------------
# Engine & Compiler
# ------------------------------------------------------------------------------

# Centralized URL or filepath to fetch compiled RPZ zones from.
LIST_SOURCE=https://raw.githubusercontent.com/QuasyStellar/NextPATH/lists-release/result.tar.gz

# Interval for polling remote HTTP ETag to check for list updates.
LIST_POLL_INTERVAL=2h

# Enable local compilation of routing lists upon engine startup and periodic reload. (y/n)
COMPILE_LOCAL=n

# Interval for local list recompilation.
COMPILE_INTERVAL=24h

# Compile/download lists once and immediately exit (useful for CI).
COMPILE_ONLY=n

# Compiles all processed domains as specific intercept routes. (y/n)
ROUTE_ALL=n

# Process and filter out adblock/tracking hosts. (y/n)
BLOCK_ADS=y

# Filter out gambling and online-casino domains from compiled lists. (y/n)
FILTER_CASINO=y

# Max DNS queries per second per source IP.
DNS_RATE_LIMIT=300

# Maximum network prefixes per nftables set.
AGGREGATE_COUNT=500

# ------------------------------------------------------------------------------
# Fake-IP Pool
# ------------------------------------------------------------------------------

# Fake-IP IPv4 prefix.
FAKE_IP=198.18
# Fake-IP IPv4 subnet CIDR mask.
POOL_SIZE_V4=15

# Fake-IP IPv6 prefix.
FAKE_IP6=fd00:18::
# Fake-IP IPv6 subnet CIDR mask.
POOL_SIZE_V6=111

# Maximum TTL (in seconds) for Fake-IP DNS responses.
MAX_FAKE_IP_TTL=300

# ------------------------------------------------------------------------------
# P2P Sync Configuration
# ------------------------------------------------------------------------------

# (Optional) Comma-separated list of peer nodes for cluster synchronization.
PEERS=

# P2P synchronization listening port.
SYNC_PORT=5353

# P2P cluster authentication token.
NEXTPATH_SYNC_TOKEN=change_me_to_a_secure_random_string

# --- P2P TLS Certificate Mount Instructions ---
# For Docker Compose: Mount them as volumes (e.g., - ./certs:/app/nextpath/certs:ro)
# For Docker Swarm: They are natively injected via secrets into /run/secrets/cert.pem

# P2P TLS Certificate absolute filepath (inside the container).
# Defaults to /app/nextpath/certs/cert.pem, or /run/secrets/cert.pem for Docker Swarm
NEXTPATH_SYNC_CERT=

# P2P TLS Private Key absolute filepath (inside the container).
# Defaults to /app/nextpath/certs/key.pem, or /run/secrets/key.pem for Docker Swarm
NEXTPATH_SYNC_KEY=

# Enable strict TLS verification for P2P Sync. ("y", "n", "pinning")
NEXTPATH_SYNC_STRICT_TLS=y

# The expected 32-byte HEX fingerprint(s) of the peer's TLS certificate.
NEXTPATH_SYNC_CERT_FINGERPRINT=

# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# Metrics & Debug
# ------------------------------------------------------------------------------

# Enable Prometheus metrics. (y/n)
METRICS_ENABLE=n

# Metrics bind IP.
METRICS_ADDR=127.0.0.1

# Metrics bind port.
METRICS_PORT=9090

# Enable debug logs. (y/n)
DEBUG=n

# ------------------------------------------------------------------------------
# Internal Architecture (Advanced)
# ------------------------------------------------------------------------------

# IP address for NextPATH DNS (intercepts and proxies selected domains).
NEXTPATH_DNS_IP=10.77.77.77

# IP address for Global DNS (resolves all domains cleanly without interception).
GLOBAL_DNS_IP=10.88.88.88

# Local loopback IP address for NextPATH DNS (Knot Resolver Instance 1).
DNS_ADDR_1=127.0.0.1

# Local loopback IP address for Full DNS (Knot Resolver Instance 2).
DNS_ADDR_2=127.0.0.2

# Internal IP address where the Go DNS proxy binds.
PROXY_ADDR=127.0.0.3

# Internal port where the Go DNS proxy binds.
PROXY_PORT=53

# Define how many Knot Resolver background worker instances should be launched.
KRESD_WORKERS=auto

# Knot Resolver RAM cache size PER INSTANCE.
# Since NextPATH runs 2 instances (NextPATH DNS + Global DNS), total RAM usage will be double this value.
# (e.g., '10%' means 20% total, '512' means 1024MB total).
CACHE_SIZE=

# (Optional) Maximum cache TTL in seconds for Knot Resolver upstream records (default: 7200 = 2 hours).
CACHE_MAX_TTL=

# (Optional) Minimum cache TTL in seconds for Knot Resolver (default: 60).
MIN_TTL=

# (Optional) Negative cache TTL in seconds for Knot Resolver (default: 60).
NEG_TTL=
